<Window x:Class="ErpHub.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ErpHub"
        mc:Ignorable="d"
        Title="Poslovni Sistem — ERP Control Center"
        Height="740" Width="1120"
        MinHeight="650" MinWidth="980"
        WindowStartupLocation="CenterScreen"
        Background="#F4F6F9"
        FontFamily="Segoe UI, Roboto, sans-serif">

    <Window.Resources>
        <!-- Shadow Drop Effect -->
        <DropShadowEffect x:Key="CardShadow" BlurRadius="15" ShadowDepth="4" Direction="270" Color="#1E000000" Opacity="0.12"/>
        <DropShadowEffect x:Key="HeaderShadow" BlurRadius="10" ShadowDepth="2" Direction="270" Color="#2E000000" Opacity="0.15"/>

        <!-- Button Style Base -->
        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#2563EB"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="18,10"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#1D4ED8"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#9CA3AF"/>
                    <Setter Property="Foreground" Value="#E5E7EB"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <Style x:Key="UpdateButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#F59E0B"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="18,9"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#D97706"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#9CA3AF"/>
                    <Setter Property="Foreground" Value="#E5E7EB"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SecondaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#E5E7EB"/>
            <Setter Property="Foreground" Value="#374151"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#D1D5DB"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Top Bar Header -->
            <RowDefinition Height="*"/>    <!-- Module Cards Grid -->
            <RowDefinition Height="Auto"/> <!-- Status Footer -->
        </Grid.RowDefinitions>

        <!-- TOP BAR HEADER -->
        <Border Grid.Row="0" Background="#1E293B" Padding="24,18" Effect="{StaticResource HeaderShadow}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="🚀" FontSize="26" Margin="0,0,12,0"/>
                    <StackPanel>
                        <TextBlock Text="Poslovni Sistem — ERP Control Center" FontSize="20" FontWeight="Bold" Foreground="White"/>
                        <TextBlock Text="Centralni upravljački panel sa nezavisnom selekcijom baza po modulima" FontSize="12" Foreground="#94A3B8" Margin="0,2,0,0"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="🔄 Osveži status" Click="BtnRefresh_Click" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,10,0"/>
                    <Button Content="⚙️ Podešavanja" Click="BtnSettings_Click" Style="{StaticResource SecondaryButtonStyle}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- MODULE CARDS GRID -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="20">
            <ItemsControl x:Name="ModuleItemsControl">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="3"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>

                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="10" Background="White" CornerRadius="12" Effect="{StaticResource CardShadow}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="105"/> <!-- Card Header Banner -->
                                    <RowDefinition Height="*"/>   <!-- Card Body Content -->
                                    <RowDefinition Height="Auto"/> <!-- Card Footer Actions -->
                                </Grid.RowDefinitions>

                                <!-- Header Banner with Gradient -->
                                <Border Grid.Row="0" CornerRadius="12,12,0,0" Padding="16">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="{Binding HeaderGradientStart}" Offset="0"/>
                                            <GradientStop Color="{Binding HeaderGradientEnd}" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Border.Background>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Text="{Binding Icon}" FontSize="40" VerticalAlignment="Center" Margin="0,0,12,0"/>

                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Title}" FontSize="18" FontWeight="Bold" Foreground="White" TextWrapping="Wrap"/>
                                            <TextBlock Text="{Binding Subtitle}" FontSize="11" Foreground="#F1F5F9" TextWrapping="Wrap" Margin="0,3,0,0" Opacity="0.9"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <!-- Body Details -->
                                <Border Grid.Row="1" Padding="16">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Description}" FontSize="12" Foreground="#475569" TextWrapping="Wrap" Height="58" LineHeight="17"/>

                                        <Separator Margin="0,8" Background="#F1F5F9"/>

                                        <!-- Selektor Baze / Preduzeća za ovaj modul -->
                                        <StackPanel Margin="0,2,0,8">
                                            <TextBlock Text="🏢 Aktivna baza / preduzeće:" FontSize="11.5" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,4"/>
                                            <ComboBox ItemsSource="{Binding Companies}" DisplayMemberPath="DisplayText"
                                                      SelectedItem="{Binding SelectedCompany, Mode=TwoWay}"
                                                      FontSize="12" Padding="8,5" Background="#F8FAFC"/>
                                        </StackPanel>

                                        <Grid Margin="0,4,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Status:" FontSize="12" FontWeight="SemiBold" Foreground="#64748B"/>
                                            <TextBlock Grid.Column="1" Text="{Binding StatusText}" FontSize="12" FontWeight="Bold" HorizontalAlignment="Right"/>
                                        </Grid>

                                        <Grid Margin="0,4,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Verzija:" FontSize="12" Foreground="#64748B"/>
                                            <TextBlock Grid.Column="1" Text="{Binding InstalledVersion}" FontSize="12" Foreground="#334155" HorizontalAlignment="Right"/>
                                        </Grid>

                                        <Grid Margin="0,4,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Ažurnost:" FontSize="12" Foreground="#64748B"/>
                                            <TextBlock Grid.Column="1" Text="{Binding UpdateStatusText}" FontSize="12" FontWeight="SemiBold" Foreground="#334155" HorizontalAlignment="Right"/>
                                        </Grid>

                                        <Grid Margin="0,4,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Registrovane baze:" FontSize="12" Foreground="#64748B"/>
                                            <TextBlock Grid.Column="1" Text="{Binding CompanyCountText}" FontSize="12" FontWeight="SemiBold" Foreground="#2563EB" HorizontalAlignment="Right"/>
                                        </Grid>

                                        <Grid Margin="0,4,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Zadnje pokretanje:" FontSize="12" Foreground="#64748B"/>
                                            <TextBlock Grid.Column="1" Text="{Binding LastLaunchedText}" FontSize="12" Foreground="#64748B" HorizontalAlignment="Right"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <!-- Footer Action Buttons -->
                                <Border Grid.Row="2" Padding="16,12" Background="#F8FAFC" CornerRadius="0,0,12,12" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0">
                                    <StackPanel>
                                        <StackPanel Visibility="{Binding ShowUpdateArea, Converter={StaticResource BoolToVis}}" Margin="0,0,0,8">
                                            <Button Content="{Binding UpdateButtonText}" Tag="{Binding}" Click="BtnUpdateModule_Click"
                                                    IsEnabled="{Binding CanUpdateFromHub}"
                                                    Style="{StaticResource UpdateButtonStyle}" HorizontalAlignment="Stretch"
                                                    ToolTip="Preuzmi i primeni ažuriranje direktno iz ErpHub-a"/>
                                            <StackPanel Visibility="{Binding IsUpdating, Converter={StaticResource BoolToVis}}" Margin="0,7,0,0">
                                                <ProgressBar Value="{Binding UpdateProgressPercent, Mode=OneWay}" Maximum="100" Height="7"
                                                             IsIndeterminate="{Binding UpdateIsIndeterminate}" Foreground="#F59E0B"/>
                                                <TextBlock Text="{Binding UpdateProgressLabel}" FontSize="10.5" Foreground="#64748B"
                                                           HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                            </StackPanel>
                                        </StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Button Content="▶ Pokreni Modul" Tag="{Binding}" Click="BtnLaunchModule_Click"
                                                    IsEnabled="{Binding CanLaunch}"
                                                    Style="{StaticResource PrimaryButtonStyle}" HorizontalAlignment="Stretch" Margin="0,0,8,0"/>
                                            <Button Grid.Column="1" Content="📂 Baze" Tag="{Binding BazeFolderPath}" Click="BtnOpenBazeFolder_Click"
                                                    Style="{StaticResource SecondaryButtonStyle}" ToolTip="Otvori folder sa bazama podataka na disku"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- STATUS FOOTER -->
        <Border Grid.Row="2" Background="#1E293B" Padding="16,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="TxtStatus" Text="ERP Hub spreman za rad." Foreground="#94A3B8" FontSize="12"/>
                <TextBlock Grid.Column="1" x:Name="TxtVersionInfo" Text="Velopack Auto-Update Active • v1.0.0" Foreground="#64748B" FontSize="12"/>
            </Grid>
        </Border>
    </Grid>
</Window>
