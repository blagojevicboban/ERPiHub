<Window x:Class="ERPiHub.UpdateDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ažuriranje ERP Hub-a"
        Height="240" Width="450"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="Transparent"
        WindowStyle="None"
        AllowsTransparency="True"
        FontFamily="Segoe UI, Roboto, sans-serif">

    <Border Padding="20" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" Margin="10" CornerRadius="12">
        <Border.Effect>
            <DropShadowEffect BlurRadius="20" Direction="270" ShadowDepth="4" Color="#000000" Opacity="0.15"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Text="🔄 Dostupna je nova verzija ERP Hub-a!"
                       FontSize="16"
                       FontWeight="Bold"
                       Foreground="#1E293B"
                       Margin="0,0,0,10"/>

            <TextBlock x:Name="MessageText"
                       Grid.Row="1"
                       Text="Da li želite da preuzmete i instalirate novu verziju aplikacije sada?"
                       Foreground="#475569"
                       TextWrapping="Wrap"
                       FontSize="13.5"
                       VerticalAlignment="Top"/>

            <!-- Progress elementi -->
            <StackPanel x:Name="ProgressPanel" Grid.Row="2" Visibility="Collapsed" Margin="0,10,0,0">
                <TextBlock x:Name="ProgressText" Text="Preuzimanje: 0%"
                           Margin="0,0,0,6" FontSize="12.5"
                           Foreground="#64748B"/>
                <ProgressBar x:Name="UpdateProgress"
                             Height="10" Minimum="0" Maximum="100" Value="0"
                             Foreground="#2563EB"
                             BorderThickness="0"
                             Background="#E2E8F0"/>
            </StackPanel>

            <!-- Dugmad -->
            <StackPanel x:Name="ButtonPanel" Grid.Row="3"
                        Orientation="Horizontal" HorizontalAlignment="Right"
                        Margin="0,15,0,0">
                <Button Content="Kasnije"
                        Width="100" Margin="0,0,10,0" Height="36"
                        Background="#F1F5F9" Foreground="#475569" BorderThickness="0" FontWeight="SemiBold" Cursor="Hand"
                        Click="BtnCancel_Click"/>
                <Button Content="Ažuriraj sada"
                        Width="130" Height="36"
                        Background="#2563EB" Foreground="White" BorderThickness="0" FontWeight="SemiBold" Cursor="Hand"
                        Click="BtnUpdate_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
